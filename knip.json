{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["tools/verify/journeys/*.mjs"],
      "project": ["tools/verify/**/*.mjs"]
    },
    "apps/server": {
      "entry": ["src/scripts/*.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "e2e/**/*.ts", "*.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/domain": {
      "entry": ["scripts/*.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    },
    "packages/api": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/db": {
      "entry": ["scripts/*.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ai": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tools/tsconfig": {}
  }
}
