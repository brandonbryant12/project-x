{
  "name": "@repo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "typecheck": "tsc7 -p .",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/scripts/seed.ts --reset"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@repo/ai": "workspace:*",
    "@repo/api": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "nodemailer": "10.5.0",
    "openid-client": "catalog:",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
