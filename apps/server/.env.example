# Copy to apps/server/.env for local development. Every value is decoded and
# validated in src/platform/config.ts (the only place that reads env).

NODE_ENV=development
PORT=4400
# Public origin of the web app; used for CSRF origin checks and redirects.
APP_ORIGIN=http://localhost:5400

# PostgreSQL (start with `pnpm db:up`). `pglite:.data/dev` runs an in-process
# Postgres with no Docker, for quick experiments only.
DATABASE_URL=postgres://app:app@localhost:5442/app
DB_MIGRATE_ON_START=true

# `dev` enables the persona picker; it refuses to start with NODE_ENV=production.
AUTH_MODE=dev
# AUTH_MODE=entra needs all four (docs/architecture/identity-and-access.md):
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# AUTH_FLOW_SECRET=   # 32+ random bytes

# Assistant checks (ADR 0008): disabled | mock | live.
DECISIONS_MODE=mock
# live also needs a paid-tier key (the free tier may train on inputs):
# DECISIONS_API_KEY=
# DECISIONS_PAID_TIER_CONFIRMED=true

# LangSmith tracing of assistant checks (ADR 0016). Off by default.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=coaching-dev
# Content sent to LangSmith: none (digests and keys only) | screened.
# LANGSMITH_CONTENT=none

# Telemetry (ADR 0013): OTLP to the Datadog Agent or the local Aspire dashboard.
TELEMETRY_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=app-server
OTEL_ENV=local
LOG_FORMAT=pretty
SCHEDULER_ENABLED=true

# Notifications (ADR 0018). `log` records sends in the server log. For real
# email locally: `docker compose --profile mail up -d mailpit`, then
# NOTIFY_TRANSPORT=smtp SMTP_HOST=127.0.0.1 SMTP_PORT=1025 and open http://localhost:8025.
# NOTIFY_TRANSPORT=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_FROM=catalyst@northwind.example

# Product switches. Designated observers (ADR 0020): the screens for naming a
# colleague to observe someone. Off by default; existing designations still count.
# FEATURE_DESIGNATED_OBSERVERS=false
